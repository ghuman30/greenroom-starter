# Greenroom case study — environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — your key will NOT be committed.
#
# Required for the LLM extraction pipeline (T1+).

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: model override. Default is deepseek/deepseek-v4-flash:free.
# Other good free options on OpenRouter (verified May 2026 via list_free_models.py):
#   openai/gpt-oss-120b:free
#   nvidia/nemotron-3-super-120b-a12b:free
#   qwen/qwen3-next-80b-a3b-instruct:free
#   meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
